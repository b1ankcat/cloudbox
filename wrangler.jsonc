{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbox-tvbox-discover",
	"main": "index.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"0 16 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "TVBOX_RESULTS",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID",
			"remote": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}